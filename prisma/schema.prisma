// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int      @id @default(autoincrement())
  organizationId Int
  roleId         Int
  name           String
  email          String   @unique
  passwordHash   String
  // the person who created the workspace; only they decide who may "Log in as" teammates
  isOwner        Boolean  @default(false)
  // allowed by the owner to log in to teammates' accounts without their password (the owner always can)
  canLogInAs     Boolean  @default(false)
  // runs the whole website with you: sees every workspace and user, and can log in as anyone
  // (Settings > Site admin). Also everyone whose email is in SITE_ADMIN_EMAILS (src/lib/auth/siteAdmin.ts)
  isSiteAdmin    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  role               Role                @relation(fields: [roleId], references: [id])
  assignedLeads      Lead[]              @relation("LeadAssignee")
  // who created / last changed each lead, deal and contact
  createdLeads       Lead[]              @relation("LeadCreatedBy")
  updatedLeads       Lead[]              @relation("LeadUpdatedBy")
  leadTimeline       LeadTimeline[]
  leadNotes          LeadNote[]
  assignedDeals      Deal[]              @relation("DealAssignee")
  createdDeals       Deal[]              @relation("DealCreatedBy")
  updatedDeals       Deal[]              @relation("DealUpdatedBy")
  dealTimeline       DealTimeline[]
  dealNotes          DealNote[]
  contacts           Contact[]           @relation("ContactAssignee")
  createdContacts    Contact[]           @relation("ContactCreatedBy")
  updatedContacts    Contact[]           @relation("ContactUpdatedBy")
  contactTimeline    ContactTimeline[]
  contactNotes       ContactNote[]
  savedFilters       SavedFilter[]
  // scheduled calls/meetings — the person it's for, and whoever scheduled it (often the same person)
  assignedActivities ScheduledActivity[] @relation("ScheduledActivityAssignee")
  createdActivities  ScheduledActivity[] @relation("ScheduledActivityCreator")
  // activities this agent is tagged on (not the one it's assigned to), so they show on their schedule too
  taggedActivities   ScheduledActivity[] @relation("ActivityAttendees")
  // to-dos — the person who has to do it, and whoever wrote it down
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  // web forms whose leads go to this person
  leadForms          LeadForm[]          @relation("LeadFormOwner")
  // the bell: things that happened for this person, and the ones they caused for others
  notifications      Notification[]      @relation("NotificationRecipient")
  sentNotifications  Notification[]      @relation("NotificationActor")
  // CSV imports this person started
  importJobs         ImportJob[]
  // big bulk actions (deleting thousands of records) this person started
  bulkJobs           BulkJob[]
  // emails this person sent from the CRM
  sentEmails         Email[]
  // their own mailbox, connected in Profile, that their emails go out through
  emailAccount       EmailAccount?
  // leads, deals and contacts this person deleted (the recycle bin)
  deletedRecords     DeletedRecord[]

  @@index([organizationId])
  @@index([roleId])
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  // how amounts are shown ("INR", "USD"...), set in Settings > Workspace; amounts aren't converted
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  roles                  Role[]
  deletedRecords         DeletedRecord[]
  leads                  Lead[]
  pipelineStages         PipelineStage[]
  leadStages             LeadStage[]
  leadSources            LeadSource[]
  deals                  Deal[]
  contacts               Contact[]
  companies              Company[]
  customFieldDefinitions CustomFieldDefinition[]
  scheduledActivities    ScheduledActivity[]
  tasks                  Task[]
  leadForms              LeadForm[]
  notifications          Notification[]
  importJobs             ImportJob[]
  bulkJobs               BulkJob[]
  emails                 Email[]
  emailTemplates         EmailTemplate[]
  automationRules        AutomationRule[]
  products               Product[]
}

model Role {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  users        User[]
  permissions  RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Lead {
  id             Int  @id @default(autoincrement())
  organizationId Int
  assignedToId   Int?
  // Every lead gets a Contact on creation — either a new one, or an existing
  // one picked (or matched by phone), so a contact can source several leads.
  contactId      Int?

  name         String
  email        String?
  phone        String?
  companyName  String?
  sourceId     Int?
  stageId      Int
  // values for this org's CustomFieldDefinition rows (entity "lead"), keyed
  // by definition.key — e.g. { "budget_range": "50k-100k" }
  customFields Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // who made it, and who last changed it (any field, its stage or owner); null for
  // records from before this was tracked, or when that person has been removed
  // why it was lost ("Price too high"), asked when it moves to a lost stage; cleared if it reopens
  lostReason  String?
  createdById Int?
  updatedById Int?
  // the phone's last 10 digits and the email in lower case, to find copies of the same
  // person fast ("+91 98765-43210" and "9876543210" match). Never written by the app: a
  // database trigger (migration add_lead_match_keys) keeps them in step with phone and email
  phoneKey    String?
  emailKey    String?
  // the ad campaign that first brought them in, from the web form's link
  // (?utm_source=google&utm_medium=cpc&utm_campaign=diwali-sale); kept from the first submission
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  organization        Organization        @relation(fields: [organizationId], references: [id])
  assignedTo          User?               @relation("LeadAssignee", fields: [assignedToId], references: [id])
  createdBy           User?               @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?               @relation("LeadUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  contact             Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  stage               LeadStage           @relation(fields: [stageId], references: [id])
  source              LeadSource?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  timeline            LeadTimeline[]
  notes               LeadNote[]
  scheduledActivities ScheduledActivity[]
  tasks               Task[]
  deals               Deal[]
  emails              Email[]

  @@index([organizationId])
  @@index([organizationId, createdById])
  @@index([organizationId, updatedById])
  // newest-first lists, and the board's columns (one stage, newest first), without sorting every row
  @@index([organizationId, createdAt])
  @@index([organizationId, stageId, createdAt])
  @@index([assignedToId])
  @@index([stageId])
  @@index([sourceId])
  // trigram indexes: make the global search's "contains" matching (ILIKE '%acme%') fast
  @@index([name(ops: raw("gin_trgm_ops")), email(ops: raw("gin_trgm_ops")), companyName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email])
  @@index([organizationId, utmCampaign])
  @@index([organizationId, phoneKey])
  @@index([organizationId, emailKey])
  @@index([contactId])
}

// Admin-editable, mirroring Deal's PipelineStage — the columns of the leads
// board, in the order they appear. A converted or lost stage marks a lead as closed.
model LeadStage {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  order          Int      @default(0)
  color          String   @default("#64748b")
  isConverted    Boolean  @default(false)
  isLost         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, name])
  @@index([organizationId, order])
}

// Admin-editable, picked (not typed) on the lead form — same pattern as
// LeadStage, just without the converted/lost flags.
model LeadSource {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  order          Int      @default(0)
  color          String   @default("#64748b")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]
  leadForms    LeadForm[]

  @@unique([organizationId, name])
  @@index([organizationId, order])
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
  AGENT
}

// An org-defined extra field on an entity (Lead for now). The definition
// lives here; the actual values live in that entity's own `customFields`
// JSON column, keyed by `key`.
model CustomFieldDefinition {
  id             Int             @id @default(autoincrement())
  organizationId Int
  entity         String // "lead" | "deal" | "contact"
  key            String // stable machine name used inside the JSON blob
  label          String
  type           CustomFieldType
  // SELECT fields' choices, as a JSON string array
  options        Json?
  // optional heading fields with the same group cluster under on forms
  group          String?

  required     Boolean @default(false)
  showInFilter Boolean @default(false)
  showInList   Boolean @default(false)
  order        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entity, key])
  @@index([organizationId, entity])
}

// The lead's Timeline tab: an automatic, read-only log (created, stage
// changed, assigned...). See LeadNote for user-authored comments instead.
model LeadTimeline {
  id     Int @id @default(autoincrement())
  leadId Int
  userId Int

  type     String
  message  String
  metadata Json?

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

// A user-written comment on a lead, optionally @-mentioning teammates —
// unlike LeadTimeline (an automatic, read-only log), notes are authored,
// editable and deletable by their author.
model LeadNote {
  id               Int      @id @default(autoincrement())
  leadId           Int
  authorId         Int
  body             String   @db.Text
  // ids of agents @-mentioned in `body`, denormalized at write time so
  // "mentions me" queries don't need to parse the text
  mentionedUserIds Int[]    @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId, createdAt])
  @@index([authorId])
}

model PipelineStage {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  order          Int      @default(0)
  color          String   @default("#64748b")
  isWon          Boolean  @default(false)
  isLost         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@unique([organizationId, name])
  @@index([organizationId, order])
}

model Deal {
  id              Int  @id @default(autoincrement())
  organizationId  Int
  leadId          Int?
  assignedToId    Int?
  pipelineStageId Int

  title             String
  amount            Decimal   @default(0) @db.Decimal(12, 2)
  probability       Int       @default(0)
  expectedCloseDate DateTime?
  description       String?
  // values for this org's CustomFieldDefinition rows (entity "deal")
  customFields      Json?
  // when the deal moved into a won or lost stage; null while it's still open.
  // The dashboard counts "won this month" from it (updatedAt changes on any edit)
  closedAt          DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // who made it, and who last changed it (any field, its stage or owner); null for
  // records from before this was tracked, or when that person has been removed
  // why it was lost ("Price too high"), asked when it moves to a lost stage; cleared if it reopens
  lostReason  String?
  createdById Int?
  updatedById Int?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo    User?         @relation("DealAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("DealCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?         @relation("DealUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  pipelineStage PipelineStage @relation(fields: [pipelineStageId], references: [id])

  timeline            DealTimeline[]
  notes               DealNote[]
  scheduledActivities ScheduledActivity[]
  tasks               Task[]
  emails              Email[]
  // what's being sold: the lines of its quote; while it has any, its amount is their total
  products            DealProduct[]

  @@index([organizationId])
  @@index([organizationId, createdById])
  @@index([organizationId, updatedById])
  // newest-first lists, and the board's columns (one stage, newest first)
  @@index([organizationId, createdAt])
  @@index([organizationId, pipelineStageId, createdAt])
  @@index([assignedToId])
  @@index([leadId])
  @@index([expectedCloseDate])
  @@index([organizationId, closedAt])
  // trigram indexes: make the global search's "contains" matching (ILIKE '%acme%') fast
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

// The deal's Timeline tab: an automatic, read-only log. See DealNote for
// user-authored comments instead.
model DealTimeline {
  id        Int      @id @default(autoincrement())
  dealId    Int
  userId    Int
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([dealId, createdAt])
  @@index([userId])
}

// A user-written comment on a deal, optionally @-mentioning teammates —
// unlike DealTimeline (an automatic, read-only log), notes are authored,
// editable and deletable by their author.
model DealNote {
  id               Int      @id @default(autoincrement())
  dealId           Int
  authorId         Int
  body             String   @db.Text
  // ids of agents @-mentioned in `body`, denormalized at write time so
  // "mentions me" queries don't need to parse the text
  mentionedUserIds Int[]    @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([dealId, createdAt])
  @@index([authorId])
}

model Contact {
  id             Int  @id @default(autoincrement())
  organizationId Int
  companyId      Int?
  assignedToId   Int?

  name         String  @db.VarChar(200)
  email        String? @db.VarChar(255)
  // required and unique per org — a contact is how leads dedupe by phone,
  // so two contacts sharing a phone would defeat that entirely
  phone        String  @db.VarChar(20)
  jobTitle     String? @db.VarChar(150)
  description  String? @db.Text
  // values for this org's CustomFieldDefinition rows (entity "contact")
  customFields Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // who made it, and who last changed it (any field, its stage or owner); null for
  // records from before this was tracked, or when that person has been removed
  createdById Int?
  updatedById Int?

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company             Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo          User?               @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy           User?               @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?               @relation("ContactUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  // every lead sourced from (or linked to) this contact — a contact isn't
  // limited to a single lead, e.g. the same person re-engaging later
  leads               Lead[]
  timeline            ContactTimeline[]
  notes               ContactNote[]
  emails              Email[]
  scheduledActivities ScheduledActivity[]
  tasks               Task[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([organizationId, createdById])
  @@index([organizationId, updatedById])
  // newest-first lists
  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@index([companyId])
  @@index([assignedToId])
  @@index([organizationId, name])
  // trigram indexes: make the global search's "contains" matching (ILIKE '%acme%') fast
  @@index([name(ops: raw("gin_trgm_ops")), email(ops: raw("gin_trgm_ops"))], type: Gin)
}

// The contact's Timeline tab: an automatic, read-only log. See ContactNote
// for user-authored comments instead.
model ContactTimeline {
  id        Int      @id @default(autoincrement())
  contactId Int
  userId    Int
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([contactId, createdAt])
  @@index([userId])
}

// A user-written comment on a contact, optionally @-mentioning teammates —
// unlike ContactTimeline (an automatic, read-only log), notes are authored,
// editable and deletable by their author.
model ContactNote {
  id               Int      @id @default(autoincrement())
  contactId        Int
  authorId         Int
  body             String   @db.Text
  // ids of agents @-mentioned in `body`, denormalized at write time so
  // "mentions me" queries don't need to parse the text
  mentionedUserIds Int[]    @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([contactId, createdAt])
  @@index([authorId])
}

model Company {
  id             Int @id @default(autoincrement())
  organizationId Int

  name        String  @db.VarChar(200)
  website     String? @db.VarChar(255)
  industry    String? @db.VarChar(100)
  phone       String? @db.VarChar(20)
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]

  @@index([organizationId])
  @@index([organizationId, name])
}

// A user's own named filter presets for a list page (Leads, Deals, Contacts).
// Personal, not shared with the rest of the org.
model SavedFilter {
  id     Int    @id @default(autoincrement())
  userId Int
  entity String // "lead" | "deal" | "contact"
  name   String

  // the exact filter object the list page already sends as query params,
  // e.g. { "status": "NEW", "assignedTo": "me" }
  filters Json

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entity])
}

enum ScheduledActivityType {
  CALL
  MEETING
  OTHER
}

enum ScheduledActivityStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// A call/meeting/reminder booked for a specific date and time — distinct from
// Timeline (an automatic log) and from Notes (freeform, untimed comments).
// Deliberately one shared table rather than split per entity like
// LeadTimeline/DealTimeline/ContactTimeline: a reminder scheduler needs to
// efficiently ask "what's due soon for this user" across every record type
// in one query, which a 3-table split would make much harder for no benefit.
model ScheduledActivity {
  id              Int                     @id @default(autoincrement())
  organizationId  Int
  type            ScheduledActivityType
  status          ScheduledActivityStatus @default(SCHEDULED)
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int?
  // when the "starting in 10 minutes" reminder went out, so it goes out once; cleared when
  // the activity is moved to another time
  reminderSentAt  DateTime?

  // who the reminder is for, and who booked it (often the same person)
  assignedToId Int
  createdById  Int

  // the record this is about — at most one of these is set; none set = a
  // general reminder not tied to a specific record
  leadId    Int?
  dealId    Int?
  contactId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User         @relation("ScheduledActivityAssignee", fields: [assignedToId], references: [id])
  createdBy    User         @relation("ScheduledActivityCreator", fields: [createdById], references: [id])
  // other agents tagged on it, e.g. everyone in a meeting; it shows on each of their schedules
  attendees    User[]       @relation("ActivityAttendees")
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([organizationId, scheduledAt])
  @@index([assignedToId, scheduledAt])
  @@index([leadId])
  @@index([dealId])
  @@index([contactId])
  // trigram indexes: make the global search's "contains" matching (ILIKE '%acme%') fast
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

// The task board's three columns: To do, In progress, Done
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// Declared lowest to highest: Postgres sorts an enum in declaration order,
// so ordering by priority desc puts the most important first
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// A plain to-do with a deadline day — no time of day, unlike ScheduledActivity,
// which is a booked slot. Same one-shared-table shape as ScheduledActivity, so
// "what's on my plate" is a single query across leads, deals and contacts.
model Task {
  id             Int          @id @default(autoincrement())
  organizationId Int
  title          String
  description    String?
  status         TaskStatus   @default(PENDING)
  // when it was ticked off; null while it's still to do. The dashboard counts work done from it
  completedAt    DateTime?
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime     @db.Date

  // who has to do it, and who wrote it down (often the same person)
  assignedToId Int
  createdById  Int

  // the record this is about — at most one of these is set; none set = a
  // general to-do not tied to a specific record
  leadId    Int?
  dealId    Int?
  contactId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueDate])
  @@index([organizationId, completedAt])
  @@index([assignedToId, status, dueDate])
  @@index([leadId])
  @@index([dealId])
  @@index([contactId])
  // trigram indexes: make the global search's "contains" matching (ILIKE '%acme%') fast
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

// A web form that creates leads: a website's "contact us" or "book a demo" form posts to
// /api/public/forms/<key>, no login needed. Each new lead is tagged with the form's source,
// given to its owner along with a task to reply, and skipped if that person is already a lead.
model LeadForm {
  id             Int      @id @default(autoincrement())
  organizationId Int
  // FORM = a web form (hosted page / HTML embed); WEBHOOK = a lead integration: another
  // tool (Google Ads, IndiaMART, Zapier/Make/Pabbly, a developer's code) posting leads to
  // /api/public/leads/<key>. Both share the source, owner, rotation and capture rules.
  kind           String   @default("FORM")
  // "Website demo requests"
  name           String
  // the form's public id, in its link and embed code: long and random, so it can't be guessed
  key            String   @unique
  // what new leads are tagged with, and who gets them (null = left unassigned)
  sourceId       Int?
  ownerId        Int?
  // or share them out in turn between these people (round-robin); when set, this wins over ownerId
  assigneeIds    Int[]    @default([])
  // how many leads the rotation has handed out, so the next one goes to the next person
  turn           Int      @default(0)
  // what the form asks and how its page reads: title, intro, button, thank-you message,
  // which built-in fields show, and which lead custom fields it asks for. Read through
  // readFormSettings() (src/lib/validations/leadForms.ts), which fills in the defaults.
  settings       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       LeadSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  owner        User?        @relation("LeadFormOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deliveries   LeadFormDelivery[]

  @@index([organizationId])
}

// What arrived at a lead integration and what became of it, so whoever set it up can see
// "Google Ads sent Rahul at 10:42 → new lead" or "rejected: Phone is missing". The newest
// 50 per integration are kept.
model LeadFormDelivery {
  id        Int      @id @default(autoincrement())
  formId    Int
  // CREATED (a new lead), UPDATED (an open lead they already were), REJECTED
  status    String
  // what happened, in words
  message   String
  leadId    Int?
  // what the other tool sent, as it arrived (trimmed if very large)
  payload   Json?
  createdAt DateTime @default(now())

  form LeadForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
}

// One entry in someone's bell: "Priya assigned you a lead". Saved so it's still there after
// a reload, and pushed to them live over Socket.IO the moment it's created (see
// src/lib/realtime). `link` is where clicking it goes, e.g. /leads?open=12.
model Notification {
  id             Int       @id @default(autoincrement())
  organizationId Int
  // who it's for
  userId         Int
  // who caused it; null when nobody did (a reminder, or a visitor filling in a web form)
  actorId        Int?
  // LEAD_ASSIGNED, DEAL_ASSIGNED, TASK_ASSIGNED, ACTIVITY_INVITED, MENTIONED, REMINDER
  type           String
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor        User?        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  // the bell's list (newest first) and its unread count
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// One CSV import: the file, how its columns map to fields, and how far it's got. The upload
// saves this row and puts its id on the BullMQ queue (Redis); the worker in server.ts reads
// the file from here, works through it in batches and keeps the counts up to date (see
// docs/QUEUES.md). Kept afterwards as the import's history, with the rows that failed.
model ImportJob {
  id             Int       @id @default(autoincrement())
  organizationId Int
  // who started it: the leads are created as them, and they're told when it's done
  userId         Int
  // what's being imported: "lead" for now
  entity         String
  fileName       String
  // QUEUED → RUNNING → DONE, or FAILED (the whole job; single rows that fail are counted below)
  status         String    @default("QUEUED")
  // { "<CSV column>": "name" | "email" | "phone" | ... | "cf:<custom field key>" }
  mapping        Json
  // what rows get when their own column is empty or unmapped: { stageId, sourceId, ownerId }
  defaults       Json      @default("{}")
  // the file itself; cleared once it's done
  csv            String?   @db.Text
  total          Int       @default(0)
  processed      Int       @default(0)
  created        Int       @default(0)
  // people who were already open leads (or appeared twice in the file)
  skipped        Int       @default(0)
  failed         Int       @default(0)
  // the rows that failed, as CSV with a "Problem" column, for downloading
  errorsCsv      String?   @db.Text
  // why the whole job failed, if it did
  error          String?
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// A bulk action too big for one request, e.g. deleting or reassigning 4,000 leads: which records were
// picked (a snapshot taken when it started) and how far it's got. Run by the BullMQ worker
// in batches, like an import (see docs/QUEUES.md).
model BulkJob {
  id             Int       @id @default(autoincrement())
  organizationId Int
  // who started it: the records are changed as them, within what they may do
  userId         Int
  // "lead" | "deal" | "contact"
  entity         String
  // "delete" | "stage" | "assign"
  action         String
  // what the action needs: { stageId, lostReason } to move them, { assignedToId } to assign them
  params         Json      @default("{}")
  ids            Int[]
  // QUEUED → RUNNING → DONE, or FAILED
  status         String    @default("QUEUED")
  total          Int
  processed      Int       @default(0)
  // how many were actually changed (some may have gone already, or be out of reach now)
  affected       Int       @default(0)
  error          String?
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// One email sent from the CRM to a lead, a contact, or a deal's customer. The API saves it as QUEUED
// and puts its id on the "emails" queue; the worker sends it over SMTP (src/lib/emails) and
// marks it SENT or FAILED. SKIPPED = the demo workspace, which never sends real email.
// Replies go to the sender's own inbox (Reply-To), so they aren't tracked here.
model Email {
  id             Int       @id @default(autoincrement())
  organizationId Int
  // what it's about: a lead, a deal or a contact (exactly one)
  leadId         Int?
  dealId         Int?
  contactId      Int?
  sentById       Int?
  to             String
  subject        String
  // plain text, as typed; the worker turns line breaks into HTML
  body           String
  // QUEUED, SENT, FAILED or SKIPPED
  status         String    @default("QUEUED")
  // why it failed, or why it was skipped
  error          String?
  sentAt         DateTime?
  // the first time the tracking image in it was loaded (open tracking); may be a mail app
  // loading images by itself, so it reads as "Opened", never "Read"
  openedAt       DateTime?
  // the random id in the tracking image's address, so opens can't be faked by guessing ids
  trackingToken  String    @unique
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sentBy       User?        @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([dealId, createdAt])
  @@index([contactId, createdAt])
  @@index([organizationId])
}

// A reusable email ("Follow-up after demo"), written in Settings > Email templates.
// {{lead.name}}, {{me.name}} and the like are filled in when it's picked (src/lib/emails/templates.ts).
// A person's own mailbox, connected in Settings > Profile. Their emails from the CRM go out
// through it (SMTP), so they're sent from their own address and replies come back to them.
// The password is an app password (Gmail: Google account > App passwords), stored encrypted
// (src/lib/emails/account.ts) and never sent back to the browser.
model EmailAccount {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  // "priya@gmail.com": the address emails are sent from, and the SMTP login
  email             String
  host              String
  port              Int
  passwordEncrypted String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The recycle bin. Deleting a lead, deal or contact still deletes it for real (so every list,
// search and count stays as it was), but first a copy of it and of everything deleted with it
// (timeline, notes, tasks, calls and meetings, emails) is kept here, so for 30 days it can be put
// back as it was, same id and all. See src/lib/recycleBin.ts.
model DeletedRecord {
  id             Int      @id @default(autoincrement())
  organizationId Int
  // "lead", "deal" or "contact"
  entity         String
  // its id before it was deleted, and again after it's restored
  recordId       Int
  // what the bin shows: the lead's or contact's name, the deal's title
  name           String
  // the record and what went with it, as it was
  data           Json
  // its owner when it was deleted: who else can see it in the bin
  ownerId        Int?
  deletedById    Int?
  deletedAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deletedBy    User?        @relation(fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([organizationId, deletedAt])
}

model EmailTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  subject        String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// A "when → if → then" recipe the workspace sets up in Settings > Automations:
//   when a lead is created, if its source is Google Ads, then assign it to Priya,
//   send the "First reply" email and add a call task.
// The worker runs it (src/lib/automations/engine.ts). Conditions and actions are JSON,
// checked by automationRuleSchema (src/lib/validations/automations.ts).
model AutomationRule {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  // what sets it off: "lead.created", "deal.won"... (AUTOMATION_TRIGGERS)
  trigger        String
  // [{ field: "source", op: "is", value: "12" }], all of which have to match
  conditions     Json     @default("[]")
  // [{ type: "assign", userIds: [4, 7] }, { type: "email", templateId: 3 }, ...], run in order
  actions        Json     @default("[]")
  enabled        Boolean  @default(true)
  // rules run top to bottom
  order          Int      @default(0)
  // how many leads its "assign, taking turns" action has handed out
  turn           Int      @default(0)
  // whose name its timeline entries go under
  createdById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId, trigger])
}

// One time a rule's conditions matched and it ran: what it did, or why it stopped. The newest
// 50 per rule are kept. (ruleId, eventKey) is unique, so a job that's retried never runs a
// rule twice for the same event: no second email, no second task.
model AutomationRun {
  id        Int      @id @default(autoincrement())
  ruleId    Int
  // "lead.created:812", or with the stage for stage moves: "deal.won:55:9"
  eventKey  String
  // the lead or deal it ran for
  leadId    Int?
  dealId    Int?
  // RUNNING, DONE or FAILED
  status    String
  // "Assigned to Priya · Emailed rahul@acme.com · Task "Call Rahul""
  summary   String   @default("")
  createdAt DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, eventKey])
  @@index([ruleId, createdAt])
}

// What the workspace sells, at its list price (Settings > Products)
model Product {
  id             Int      @id @default(autoincrement())
  organizationId Int
  name           String
  price          Decimal  @db.Decimal(12, 2)
  // GST or VAT, as a percent of the price: 18 means 18%
  taxPercent     Float    @default(0)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealLines    DealProduct[]

  @@index([organizationId])
}

// One line of a deal's quote. Name, price and tax are copied from the product when it's added,
// so changing the catalogue later doesn't change quotes already sent; they can be changed per deal
model DealProduct {
  id              Int      @id @default(autoincrement())
  dealId          Int
  // the catalogue product it came from; null for a one-off line, or once that product is deleted
  productId       Int?
  name            String
  price           Decimal  @db.Decimal(12, 2)
  quantity        Int      @default(1)
  discountPercent Float    @default(0)
  taxPercent      Float    @default(0)
  createdAt       DateTime @default(now())

  deal    Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([dealId])
}
