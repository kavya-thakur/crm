# Copy this file to .env and fill in your own values. .env itself is never committed.

# Your local Postgres database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/crm_dev"

# Signs the login cookie. Use a long random string, e.g. the output of: openssl rand -base64 32
JWT_SECRET="change-me"

# Root site admins: these emails see every workspace and user (Settings > Site admin), can log in
# as anyone, and can make others site admins. Comma-separated; leave empty for none.
SITE_ADMIN_EMAILS=""

# Optional: a separate database for `npm test` (defaults to postgresql://mac@localhost:5432/crm_test)
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/crm_test"

# The /demo page's form: requests become leads in your own Flash workspace. Create a form in
# Settings > Web forms (in the workspace that should get them) and paste its key here.
# DEMO_FORM_KEY="paste-the-form-key"

# Redis: the job queue (CSV imports) and rate limits. Locally: brew install redis && brew services start redis
REDIS_URL=redis://localhost:6379

# The site's public address, used in link previews (the share image). Locally it's http://localhost:3000
# APP_URL="https://your-domain.com"

# Email needs nothing here: each person connects their own mailbox in Settings > Profile (their
# app password is stored encrypted with a key made from JWT_SECRET). APP_URL (above) turns on
# open tracking once the site is online.
