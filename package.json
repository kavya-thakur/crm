{
  "name": "crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=cjs --packages=external --define:import.meta.url=__import_meta_url \"--banner:js=const __import_meta_url = require('node:url').pathToFileURL(__filename).href;\" --outfile=dist/server.cjs --log-level=warning",
    "start": "NODE_ENV=production node dist/server.cjs",
    "lint": "eslint",
    "test": "vitest run",
    "db:demo": "tsx prisma/demo.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
