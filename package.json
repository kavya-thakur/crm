    "@tabler/icons": "^3.48.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "gsap": "^3.15.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.27",
    "next": "16.3.8",
    "nodemailer": "^10.3.1",
    "papaparse": "^5.4.1",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
